{
  "name": "thinktank",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "test:api:e2e": "npm run test:e2e --workspace=apps/api",
    "lint:api": "npm run lint --workspace=apps/api",
    "migration:run:api": "npm run migration:run --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true
  }
}
